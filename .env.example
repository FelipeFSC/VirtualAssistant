# Modelo de variáveis com segredos (senhas, tokens, chaves).
# Copie para o seu .env (o caminho fica em config.json, campo "envFile") e preencha.
# O .env NUNCA é commitado.
# As ferramentas em ai/tools/ e local/tools/ leem as credenciais do seu .env, não deste modelo.
# Regra: a IA nunca exibe, copia ou commita os valores deste arquivo.

# --- Azure DevOps ---
# PAT: Azure DevOps > User settings > Personal access tokens
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/sua-organizacao
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=

# --- Banco de dados ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Alternativa: string de conexão completa
# DATABASE_URL=

# --- Outras ferramentas ---
# Adicione aqui, com um comentário dizendo qual ferramenta usa a variável.
